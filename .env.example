# Copy this file to .env for local development.
# Never commit real secrets.

# Runtime
PORT=8787
NODE_ENV=development

# CORS
# Comma-separated list for production deployments.
# Example: https://app.example.com,https://www.app.example.com
ALLOWED_ORIGINS=

# Optional legacy single origin key (kept for compatibility)
ALLOWED_ORIGIN=

# Allow origin=null (file:// and sandboxed contexts).
# Keep as 1 for local dev convenience, set to 0 in production.
ALLOW_NULL_ORIGIN=1

# Mainnet access gate (0 = locked, 1 = public)
MAINNET_PUBLIC=0

# Server-side provider keys (never commit real values)
BIRDEYE_KEY=
RPC_URL=

# Admin wallet allowed to view beta waitlist emails
ADMIN_WALLET=
